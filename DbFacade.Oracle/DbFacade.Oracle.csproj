<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Condition="'$(TargetFramework)'=='net481' Or '$(TargetFramework)'=='net48' Or '$(TargetFramework)'=='net472'">
    <UseNetFramework>true</UseNetFramework>
    <TargetFamily>NET_FRAMEWORK</TargetFamily>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)'=='net11.0' Or '$(TargetFramework)'=='net10.0'">
    <UseNetFramework>false</UseNetFramework>
    <TargetFamily>NET_CORE</TargetFamily>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)'=='netstandard2.1'">
    <TargetFamily>NET_STANDARD</TargetFamily>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFamilyFramework>net481;net48;net472</TargetFamilyFramework>
    <TargetFamilyCore>net11.0;net10.0</TargetFamilyCore>
    <TargetFamilyStandard>netstandard2.1</TargetFamilyStandard>
    <TargetFrameworks>$(TargetFamilyFramework);$(TargetFamilyCore);$(TargetFamilyStandard)</TargetFrameworks>
  </PropertyGroup>
  
  <PropertyGroup>
    <AssemblyTitle>DbFacade Oracle</AssemblyTitle>
    <Title>DbFacade.Oracle</Title>
    <RootNamespace>DbFacade.Oracle</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <Version>2.2.0</Version>
    <Company>JSystemsTech</Company>
    <Product>DbFacade.Oracle .NET</Product>
    <Description>A DbFacade extension to build a data connection service to Oracle databases</Description>
    <Copyright>Copyright © 2025</Copyright>
    <PackageId>DbFacade.Oracle</PackageId>
    <Authors>JSystemsTech</Authors>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageTags>DBFacade DbFacade dbfacade domainfacade DbFacade.Net DBFacade.Net dbfacade.net dbfacade.oracle</PackageTags>
    <PackageIcon>images\icon.jpg</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageProjectUrl>https://jsystemstech.github.io/DBFacade.Net/</PackageProjectUrl>
    <PackageReleaseNotes>Release $(Version) Depreciate support for .NET8 and .NET9. Add Support for .NET11.</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIconUrl />
    <PushPackageToLocalSource>true</PushPackageToLocalSource>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFamily)'=='NET_FRAMEWORK'">
    <PackageReference Include="Oracle.ManagedDataAccess" Version="*" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFamily)'=='NET_CORE' Or '$(TargetFamily)'=='NET_STANDARD'">
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DbFacade" Version="*" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
  </ItemGroup>
  

  <ItemGroup>
    <Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Meta\DbFacadeLogoNoText.jpg" />
    <None Include="..\icon.jpg">
      <Pack>True</Pack>
      <PackagePath>images\icon.jpg</PackagePath>
      <Visible>False</Visible>
    </None>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
